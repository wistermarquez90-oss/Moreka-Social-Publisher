# Copia este archivo como .env.external solo en tu servidor privado.
# Nunca confirmes .env.external ni secretos en GitHub.
NODE_ENV=production
PORT=3000
MOREKA_HTTP_PORT=4377
PUBLIC_APP_URL=https://moreka-panel.tudominio.com
APP_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

AUTH_DRIVER=password
OWNER_EMAIL=
OWNER_PASSWORD_HASH=

STORAGE_DRIVER=local
SHOPIFY_MODE=public
SHOPIFY_PUBLIC_URL=https://www.morekashop.com
SHOPIFY_SHOP_DOMAIN=morekashop1.myshopify.com
# Para Admin GraphQL, usa SHOPIFY_MODE=admin y configura el token solo en el servidor.
SHOPIFY_API_VERSION=2026-10
SHOPIFY_ADMIN_ACCESS_TOKEN=

GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_API_KEY=

# Alternativa futura a almacenamiento local: STORAGE_DRIVER=s3
# S3_REGION=us-east-1
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# S3_BUCKET=
# S3_PREFIX=moreka
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
