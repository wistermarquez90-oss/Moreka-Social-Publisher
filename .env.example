# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Runtime portability (Kimi remains the default) ──────────────
AUTH_DRIVER=kimi          # kimi | password
STORAGE_DRIVER=kimi       # kimi | local | s3
PUBLIC_APP_URL=http://localhost:3000
LOCAL_STORAGE_DIR=./var/storage

# External owner authentication (only when AUTH_DRIVER=password)
OWNER_EMAIL=
OWNER_PASSWORD_HASH=      # scrypt$base64-salt$base64-hash

# Shopify read-only catalog
SHOPIFY_MODE=public       # public | admin
SHOPIFY_PUBLIC_URL=https://www.morekashop.com
SHOPIFY_SHOP_DOMAIN=morekashop1.myshopify.com
SHOPIFY_API_VERSION=2026-10
SHOPIFY_ADMIN_ACCESS_TOKEN=

# One scene per product; configure only in the protected worker environment
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_API_KEY=

# Optional S3 / DigitalOcean Spaces (only when STORAGE_DRIVER=s3)
S3_REGION=
S3_ENDPOINT=
S3_BUCKET=
S3_PREFIX=moreka
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
